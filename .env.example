APP_NAME="Clinica Medica Santa Ana"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_HN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clinic_santa_ana
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PUBLIC_VERIFICATION_SHOW_DIAGNOSIS=false
PUBLIC_VERIFICATION_SHOW_FULL_IDENTITY=false

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Super Administrator"
MEDICAL_DOCUMENT_DISK=local
MEDICAL_PDF_MAX_KB=15360
INSTITUTIONAL_PDF_PASSWORD=
MEDICAL_PDF_ENCRYPTION=true
MEDICAL_PDF_PROCESS_TIMEOUT=120
MEDICAL_TEXT_QUALITY_THRESHOLD=0.55
MEDICAL_OCR_LANGUAGES=spa+eng
MEDICAL_QR_SIZE=300
MEDICAL_QR_MARGIN=20
PDFTOTEXT_BINARY=pdftotext
PDFTOPPM_BINARY=pdftoppm
PDFTOPPM_PATH=
PDFINFO_BINARY=pdfinfo
PDFTOTEXT_PATH=
TESSERACT_BINARY=tesseract
TESSERACT_PATH=
QPDF_BINARY=qpdf
QPDF_PATH=
